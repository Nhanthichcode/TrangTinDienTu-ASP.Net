@page


<style>
    /* CNN Style Base */
    .cnn-container {
        font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
        color: #222;
    }

    .cnn-header {
        font-size: 2.5rem;
        font-weight: 800;
        color: #000;
        border-bottom: 3px solid #cc0000; /* CNN Red underline */
        padding-bottom: 15px;
        margin-bottom: 30px;
        text-transform: uppercase;
    }

    .cnn-sub-header {
        font-size: 1.5rem;
        font-weight: 700;
        margin-bottom: 20px;
    }

    /* Form Styling */
    .cnn-form-control {
        border: 1px solid #ccc;
        border-radius: 0; /* Flat style */
        padding: 12px;
        font-size: 1rem;
    }

        .cnn-form-control:focus {
            border-color: #cc0000;
            box-shadow: none;
        }

    .cnn-form-label {
        font-weight: 700;
        text-transform: uppercase;
        font-size: 0.9rem;
        color: #555;
    }

    .cnn-red-btn {
        background-color: #cc0000;
        color: white;
        font-weight: 700;
        text-transform: uppercase;
        border: none;
        border-radius: 0;
        padding: 12px 25px;
        transition: background-color 0.3s;
    }

        .cnn-red-btn:hover {
            background-color: #990000;
            color: #fff;
        }

    /* Sidebar Info Box */
    .cnn-info-box {
        background-color: #f8f9fa;
        border-left: 4px solid #cc0000;
        padding: 25px;
    }

    .cnn-info-list li {
        margin-bottom: 18px;
        display: flex;
        align-items: flex-start;
    }

    .cnn-info-icon {
        color: #cc0000;
        font-size: 1.3rem;
        margin-right: 15px;
        margin-top: 3px;
    }

    .cnn-info-label {
        font-weight: 700;
        display: block;
        margin-bottom: 4px;
    }

    .map-container iframe {
        border: 1px solid #eee;
        width: 100%;
    }
</style>

<div class="container cnn-container py-5">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="cnn-header">Liên hệ & Hỗ trợ</h1>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8 mb-5">
            <h2 class="cnn-sub-header">Gửi phản hồi cho chúng tôi</h2>
            <p class="lead mb-4">Chúng tôi luôn sẵn sàng lắng nghe ý kiến của bạn. Vui lòng điền vào biểu mẫu bên dưới.</p>

            <form>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label for="name" class="form-label cnn-form-label">Họ và tên</label>
                        <input type="text" class="form-control cnn-form-control" id="name" placeholder="Nhập họ tên của bạn" required>
                    </div>
                    <div class="col-md-6">
                        <label for="email" class="form-label cnn-form-label">Email</label>
                        <input type="email" class="form-control cnn-form-control" id="email" placeholder="name@example.com" required>
                    </div>
                    <div class="col-12">
                        <label for="subject" class="form-label cnn-form-label">Chủ đề</label>
                        <input type="text" class="form-control cnn-form-control" id="subject" placeholder="Bạn cần hỗ trợ vấn đề gì?">
                    </div>
                    <div class="col-12">
                        <label for="message" class="form-label cnn-form-label">Nội dung tin nhắn</label>
                        <textarea class="form-control cnn-form-control" id="message" rows="6" placeholder="Nhập nội dung chi tiết..." required></textarea>
                    </div>
                    <div class="col-12 mt-4">
                        <button type="submit" class="btn cnn-red-btn btn-lg w-100 w-md-auto">
                            Gửi tin nhắn <i class="bi bi-send-fill ms-2"></i>
                        </button>
                    </div>
                </div>
            </form>
        </div>

        <div class="col-lg-4">
            <div class="cnn-info-box mb-4">
                <h3 class="cnn-sub-header mb-4">Thông tin tòa soạn</h3>
                <ul class="list-unstyled cnn-info-list">
                    <li>
                        <i class="bi bi-geo-alt-fill cnn-info-icon"></i>
                        <div>
                            <span class="cnn-info-label">Địa chỉ:</span>
                            Số 18 Ung Văn Khiêm, Phường Đông Xuyên, TP Long Xuyên, An Giang
                        </div>
                    </li>
                    <li>
                        <i class="bi bi-envelope-fill cnn-info-icon"></i>
                        <div>
                            <span class="cnn-info-label">Email:</span>
                            contact@agu-news.com<br>
                            support@agu-news.com
                        </div>
                    </li>
                    <li>
                        <i class="bi bi-telephone-fill cnn-info-icon"></i>
                        <div>
                            <span class="cnn-info-label">Điện thoại:</span>
                            (+86) 866 710 544<br>                            
                        </div>
                    </li>
                    <li>
                        <i class="bi bi-clock-fill cnn-info-icon"></i>
                        <div>
                            <span class="cnn-info-label">Giờ làm việc:</span>
                            Thứ 2 - Thứ 6: 8:00 - 17:00<br>
                            Thứ 7: 8:00 - 12:00
                        </div>
                    </li>
                </ul>
            </div>

            <div class="map-container">
                <h3 class="cnn-sub-header h5 mb-3">Bản đồ vị trí</h3>
                <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3924.627295379874!2d105.43015031474868!3d10.371655792596985!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x310a731e7546e819%3A0x7234d0114da2a71e!2zVHLGsOG7nW5nIMSQ4bqhaSBo4buNYyBBbiBHaWFuZyAtIMSQSFFHIEhDTQ!5e0!3m2!1svi!2s!4v1679020000000!5m2!1svi!2s"
                        width="100%" height="250" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
            </div>
        </div>
    </div>
</div>